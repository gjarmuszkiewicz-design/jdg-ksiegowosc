# Klucz API Anthropic (asystent AI). Bez klucza asystent działa w trybie offline (baza wiedzy).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
PORT=8787

# Wysyłka faktur e-mailem (SMTP). Bez konfiguracji aplikacja otwiera klienta poczty (mailto).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# KSeF: test | demo | prod
KSEF_ENV=test
# symulacja (domyślnie) | live — prawdziwa komunikacja z API KSeF
KSEF_MODE=symulacja

# Baza danych (Railway: dodaj usługę PostgreSQL i podepnij DATABASE_URL). Bez niej dane w pliku DATA_DIR/db.json.
DATABASE_URL=
DATA_DIR=./data
# true = każdy może założyć konto. Domyślnie tylko pierwsze konto (właściciel).
ALLOW_REGISTRATION=false
# Limity pytań do asystenta AI na użytkownika
AI_LIMIT_HOUR=30
AI_LIMIT_DAY=120

# Awaryjny reset hasła (ustaw oba, uruchom ponownie, zaloguj się, potem USUŃ)
RESET_PASSWORD_EMAIL=
RESET_PASSWORD_NEW=
