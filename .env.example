# Klucz API Anthropic (asystent AI). Bez klucza asystent działa w trybie offline (baza wiedzy).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
PORT=8787

# Wysyłka faktur e-mailem (SMTP). Bez konfiguracji aplikacja otwiera klienta poczty (mailto).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# KSeF: test | demo | prod
KSEF_ENV=test
# symulacja (domyślnie) | live — prawdziwa komunikacja z API KSeF
KSEF_MODE=symulacja

# Hasło do wersji online (HTTP Basic, dowolny login). Puste = bez hasła.
APP_PASSWORD=
